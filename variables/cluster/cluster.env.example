# Copy this file to cluster.env and update values for your Kubernetes cluster.
# cluster.env is ignored by Git because it may contain local IPs and key paths.

CLUSTER_NAME="proxmox-kubernetes"
ANSIBLE_USER="debian"
ANSIBLE_SSH_PRIVATE_KEY_FILE=""

KUBESPRAY_REPO_URL="https://github.com/kubernetes-sigs/kubespray.git"
KUBESPRAY_VERSION="release-2.28"
KUBESPRAY_DIR="${PWD}/.kubespray/upstream"
KUBESPRAY_INVENTORY="${PWD}/kubespray/inventory/cluster/hosts.yaml"

# Set to true to ignore host key changes for rebuilt lab nodes.
ANSIBLE_IGNORE_HOST_KEYS="true"

# Optional Kubespray extra args, for example: --limit k8s-cp-01
KUBESPRAY_EXTRA_ARGS=""
