# Copy this file to template.env and update values for your Proxmox environment.
# template.env is ignored by Git because it may contain local hostnames and key paths.

PROXMOX_HOST="pve01.example.net"
PROXMOX_USER="root"
PROXMOX_PORT="22"
# Optional private key file path. Leave empty to use ssh-agent or default SSH config.
PROXMOX_SSH_PRIVATE_KEY_FILE=""

VM_ID="9000"
VM_NAME="debian-13-k8s-template"
PROXMOX_STORAGE="local-lvm"
SNIPPET_STORAGE="local"
BRIDGE="vmbr0"
MEMORY_MB="2048"
CORES="2"
DISK_SIZE="20G"

# Set TEMPLATE_IP to use a static address. Leave empty to use DHCP.
TEMPLATE_IP=""
TEMPLATE_CIDR="24"
TEMPLATE_GATEWAY=""
TEMPLATE_NAMESERVER=""
TEMPLATE_SEARCH_DOMAIN=""

IMAGE_URL="https://cloud.debian.org/images/cloud/trixie/latest/debian-13-generic-amd64.qcow2"
IMAGE_FILE="/var/lib/vz/template/iso/debian-13-generic-amd64.qcow2"

REMOTE_PREPARE_SCRIPT="/var/lib/vz/snippets/prepare-debian-k8s.sh"

AUTO_PREPARE_TEMPLATE="true"
AUTO_CONVERT_TEMPLATE="true"
TEMPLATE_SSH_USER="debian"
# Public key injected into the template source VM by Proxmox cloud-init for prep access.
# This can be a public key file path or inline public key content.
TEMPLATE_SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"
# Optional override. Leave empty to discover the VM IPv4 address from Proxmox guest-agent data.
TEMPLATE_SSH_HOST=""
TEMPLATE_SSH_PORT="22"
TEMPLATE_SSH_PRIVATE_KEY_FILE=""
TEMPLATE_SSH_WAIT_SECONDS="300"
TEMPLATE_IP_WAIT_SECONDS="300"
