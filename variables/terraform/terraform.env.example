# Copy this file to terraform.env and update values for Terraform.
# terraform.env is ignored by Git because it contains Proxmox API credentials.

PROXMOX_API_URL="https://192.168.0.212:8006/api2/json"
PROXMOX_API_TOKEN_ID="terraform@pve!kubernetes"
PROXMOX_API_TOKEN_SECRET="replace-with-local-secret"
PROXMOX_TLS_INSECURE="true"

TARGET_NODE="pve01"

# Public key injected into Kubernetes node VMs by cloud-init.
# This can be a public key file path or inline public key content.
KUBERNETES_SSH_PUBLIC_KEY_FILE="${HOME}/.ssh/id_ed25519.pub"

# Defaults applied to generated node maps.
CONTROL_PLANE_VMID_START="2101"
WORKER_VMID_START="2201"
CONTROL_PLANE_CORES="2"
CONTROL_PLANE_MEMORY="4096"
CONTROL_PLANE_DISK_SIZE="40G"
WORKER_CORES="4"
WORKER_MEMORY="8192"
WORKER_DISK_SIZE="80G"

# Enable discard/TRIM for thin-provisioned storage reclamation.
DISK_DISCARD="true"

# Linked clones are much faster. Set true when VMs must be independent of the template disk.
FULL_CLONE="false"
